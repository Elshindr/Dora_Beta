                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "e7nrlihxd7uhied8",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT \r\n    c.name AS \"Catégorie\",\r\n    COUNT(p.idPoi) AS \"Nombre de POI\"\r\nFROM dora_beta.categorie as c\r\nJOIN dora_beta.poi_categorie as pc ON (c.idCat = pc.idCat)\r\nJOIN dora_beta.poi as p ON (p.idPoi = pc.idPoi)\r\nGROUP BY c.name\r\nORDER BY COUNT(p.idPoi) DESC",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
