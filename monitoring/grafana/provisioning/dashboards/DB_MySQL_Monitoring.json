                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT \r\n    p.name,\r\n    p.latitudePoi as latitude,\r\n    p.longitudePoi as longitude,\r\n    ROUND(AVG(a.note), 2) as note,\r\n    c.name as categorie\r\nFROM dora_beta.poi p\r\nJOIN dora_beta.avis a ON a.idPoi = p.idPoi\r\nJOIN dora_beta.poi_categorie pc ON pc.idPoi = p.idPoi\r\nJOIN dora_beta.categorie c ON c.idCat = pc.idCat\r\nGROUP BY p.idPoi, p.name, p.latitudePoi, p.longitudePoi, c.name\r\nORDER BY note DESC\r\nLIMIT 20",
                        "sql": {
