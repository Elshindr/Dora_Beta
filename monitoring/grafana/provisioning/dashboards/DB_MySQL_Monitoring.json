                        "rawQuery": true,
                        "rawSql": "SELECT c.name, ROUND(AVG(a.note), 2) as note_moyenne\r\nFROM categorie c\r\nJOIN poi_categorie pc ON c.idCat = pc.idCat\r\nJOIN avis a ON a.idPoi = pc.idPoi\r\nGROUP BY c.name\r\nORDER BY note_moyenne DESC\r\nLimit 10",
